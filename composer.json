{
    "name": "vitexsoftware/multiflexi-realpad",
    "description": "MultiFlexi support for Realpad CRM integration",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Vítězslav Dvořák",
            "email": "info@vitexsoftware.cz"
        }
    ],
    "require": {
        "vitexsoftware/multiflexi-core": ">=1.0"
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "MultiFlexi\\CredentialProtoType\\": "src/MultiFlexi/CredentialProtoType/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "*",
        "phpstan/phpstan": "*",
        "friendsofphp/php-cs-fixer": "^3.92",
        "ergebnis/composer-normalize": "^2.48",
        "ergebnis/php-cs-fixer-config": "^6.58"
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        }
    }
}
